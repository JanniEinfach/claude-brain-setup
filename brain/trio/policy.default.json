{
  "version": 3,
  "_README": "Claude Brain permission policy. Claude maintains this file. Agents must never edit it. Order matters: denyCommands is checked BEFORE any allow rule.",

  "mode": "broker",

  "_denyCommands": "Hard blocks, checked first. This ordering is what stops a chained command like 'cat README.md && rm -rf /' from slipping through on its harmless first word.",
  "denyCommands": [
    "rm\\s+(-[a-z]*\\s+)*-[a-z]*[rf]",
    "\\bdel\\s+/[sq]",
    "\\bformat\\s+[a-z]:",
    "\\bmkfs\\b",
    "\\bdd\\s+if=",
    "Remove-Item.*-Recurse.*-Force",
    "\\brmdir\\s+/s",
    "\\bshred\\b",

    "\\bgit\\s+push\\b",
    "\\bgit\\s+reset\\s+--hard\\s+origin",
    "\\bgit\\s+clean\\s+-[a-z]*[fdx]",
    "\\bgit\\s+config\\s+--global",
    "\\bgit\\s+filter-branch\\b",

    "\\bnpm\\s+(i|install)\\s+(-g|--global)",
    "\\bnpm\\s+publish\\b",
    "\\bnpm\\s+(login|adduser|token)\\b",
    "\\byarn\\s+global\\b",
    "\\bpnpm\\s+add\\s+-g",
    "\\bpip\\s+install\\b",
    "\\bcargo\\s+install\\b",
    "\\bgo\\s+install\\b",
    "\\bbrew\\s+(install|uninstall)\\b",
    "\\bwinget\\b",
    "\\bchoco\\b",
    "\\bapt(-get)?\\s+(install|remove)\\b",

    "\\|\\s*(sh|bash|zsh|pwsh|powershell|cmd)\\b",
    "\\b(iex|Invoke-Expression)\\b",
    "\\beval\\s*\\(",
    "\\b(curl|wget|Invoke-WebRequest|Invoke-RestMethod|irm|iwr)\\b",
    "\\bnc\\s+-[a-z]*l",
    "\\bssh\\b",
    "\\bscp\\b",
    "\\brsync\\b",

    "\\.ssh\\b",
    "\\.aws\\b",
    "\\.gnupg\\b",
    "auth\\.json",
    "credentials",
    "id_rsa",
    "id_ed25519",
    "\\.env\\b",
    "\\.npmrc\\b",
    "[A-Z_]*API[_]?KEY",
    "[A-Z_]*SECRET[A-Z_]*",
    "[A-Z_]*TOKEN[A-Z_]*",
    "ANTHROPIC_[A-Z_]+",
    "OPENAI_[A-Z_]+",
    "GEMINI_[A-Z_]+",

    "\\breg\\s+(add|delete)\\b",
    "\\bschtasks\\b",
    "\\bcrontab\\b",
    "\\bsc\\s+(create|delete|config)\\b",
    "\\b(taskkill|Stop-Process|Stop-Computer|shutdown|reboot)\\b",
    "\\bnetsh\\b",
    "\\bufw\\b",
    "Set-ExecutionPolicy",
    "\\bnet\\s+(user|localgroup)\\b",
    "\\bsudo\\b",
    "\\bchmod\\s+777",

    "\\bcodex\\b",
    "\\bagy\\b",
    "\\bantigravity\\b",
    "\\bclaude\\b",
    "\\bollama\\b",

    "policy\\.json",
    "policy\\.default\\.json",
    "broker\\.mjs",
    "hooks\\.json",
    "settings\\.json"
  ],

  "_protectedPaths": "Untouchable even inside the project. Without this an agent could rewrite its own supervision and grant itself anything.",
  "protectedPaths": [
    "[\\\\/]?\\.agents[\\\\/]",
    "^\\.agents$",
    "[\\\\/]?\\.git[\\\\/]",
    "[\\\\/]?\\.claude[\\\\/]",
    "[\\\\/]?\\.gemini[\\\\/]",
    "[\\\\/]?\\.codex[\\\\/]",
    "AGENTS\\.md$",
    "CLAUDE\\.md$",
    "GEMINI\\.md$",
    "policy\\.json$",
    "broker\\.mjs$",
    "hooks\\.json$",
    "settings\\.json$",
    "\\.env",
    "package-lock\\.json$"
  ],

  "_writeTools": "May only write inside the project directory, and never to a protected path.",
  "writeTools": [
    "^edit_",
    "^write_",
    "^create_",
    "^replace_",
    "^insert_",
    "^delete_",
    "^move_",
    "^rename_",
    "file_edit",
    "propose_code"
  ],

  "_allowTools": "Tools that cannot change anything. Names arrive lowercased.",
  "allowTools": [
    "^view_",
    "^read_",
    "^list_",
    "^grep",
    "^search",
    "^find_",
    "^codebase_",
    "_search$",
    "^think",
    "^plan",
    "^todo",
    "^notify",
    "^respond",
    "^message",
    "^summar"
  ],

  "_allowCommands": "Permitted command patterns, anchored at the start. The deny list above still wins.",
  "allowCommands": [
    "^\\s*(cat|type|head|tail|more|wc|nl)\\b",
    "^\\s*(ls|dir|tree)\\b",
    "^\\s*Get-(Content|ChildItem|Location|Item)\\b",
    "^\\s*(grep|rg|findstr|Select-String|ag)\\b",
    "^\\s*Test-Path\\b",
    "^\\s*(echo|pwd|cd|whoami|date|hostname)\\b",
    "^\\s*(sort|uniq|cut|awk|diff|sed\\s+-n)\\b",
    "^\\s*(node|npm|python|python3|go|cargo|java)\\s+(-v|--version)\\b",

    "^\\s*git\\s+(status|diff|log|show|ls-files|branch|rev-parse|describe|blame|remote\\s+-v)\\b",

    "^\\s*npm\\s+(test|run\\s+(test|typecheck|lint|build|dev|check|format))\\b",
    "^\\s*npm\\s+(ci|ls|outdated|why)\\b",
    "^\\s*(pnpm|yarn)\\s+(test|lint|build|typecheck)\\b",
    "^\\s*npx\\s+tsc\\s+--noEmit\\b",
    "^\\s*(vitest|jest|playwright|pytest)\\s+run\\b",
    "^\\s*(pytest|go\\s+test|cargo\\s+test)\\b"
  ],

  "_shellGrantNote": "Antigravity grants shell access only for EXACT command lines. 'command(cat)' does NOT cover 'cat README.md'. The installer seeds settings.json with the exact lines below.",
  "seedShellCommands": [
    "npm test",
    "npm run test",
    "npm run typecheck",
    "npm run lint",
    "npm run build",
    "npm ci",
    "git status",
    "git diff",
    "git log --oneline -20",
    "git branch",
    "npx tsc --noEmit",
    "pytest",
    "go test ./...",
    "cargo test"
  ],

  "_costProtection": "All network commands and every package install are blocked. No agent can reach a paid API or change the machine.",
  "_selfProtection": "policy, broker, hooks and settings files are blocked in both the command list and the protected paths.",
  "_loopProtection": "codex, agy, antigravity, claude and ollama are blocked. No agent may start another agent — that is how unattended cost spirals begin."
}
